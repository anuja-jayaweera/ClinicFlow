<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.clinicflow.Controllers.DoctorListController"
      stylesheets="@styles.css"
      spacing="14">

    <padding>
        <Insets top="10" left="10" right="10" bottom="10"/>
    </padding>

    <Label text="Doctors" styleClass="page-title"/>

    <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
            <TableColumn fx:id="specialtyColumn" text="Specialty" prefWidth="180"/>
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addButton" text="Add Doctor" onAction="#handleAdd"/>
        <Button fx:id="deleteButton" text="Delete Doctor" onAction="#handleDelete" styleClass="danger-button"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="refresh-button"/>
    </HBox>

</VBox>
