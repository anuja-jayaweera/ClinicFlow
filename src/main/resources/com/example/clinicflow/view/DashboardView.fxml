<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.clinicflow.Controllers.DashboardController"
      stylesheets="@styles.css"
      spacing="20">

    <padding>
        <Insets top="10" left="10" right="10" bottom="10"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Dashboard" styleClass="page-title"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="refresh-button"/>
    </HBox>

    <GridPane hgap="16" vgap="16">

        <!-- Total Patients -->
        <VBox styleClass="stat-card, stat-card-blue" style="-fx-padding: 16;"
              GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="190">
            <Label text="Total Patients" styleClass="stat-label"/>
            <Label fx:id="totalPatientsLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Pending Today -->
        <VBox styleClass="stat-card, stat-card-orange" style="-fx-padding: 16;"
              GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="190">
            <Label text="Pending Today" styleClass="stat-label"/>
            <Label fx:id="pendingTodayLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Completed Today -->
        <VBox styleClass="stat-card, stat-card-green" style="-fx-padding: 16;"
              GridPane.columnIndex="2" GridPane.rowIndex="0" prefWidth="190">
            <Label text="Completed Today" styleClass="stat-label"/>
            <Label fx:id="completedTodayLabel" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Cancelled Today -->
        <VBox styleClass="stat-card, stat-card-red" style="-fx-padding: 16;"
              GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="190">
            <Label text="Cancelled Today" styleClass="stat-label"/>
            <Label fx:id="cancelledTodayLabel" text="0" styleClass="stat-value"/>
        </VBox>

    </GridPane>

</VBox>
