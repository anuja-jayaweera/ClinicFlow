<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.clinicflow.Controllers.DoctorFormController"
      stylesheets="@styles.css"
      spacing="16" prefWidth="380">

    <padding>
        <Insets top="22" left="22" right="22" bottom="22"/>
    </padding>

    <Label text="Add Doctor" styleClass="form-title"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

    <GridPane hgap="10" vgap="14">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Doctor ID" styleClass="form-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="idField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Name" styleClass="form-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Specialty" styleClass="form-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="specialtyField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Phone" styleClass="form-field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="Save" onAction="#handleSave" defaultButton="true"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" cancelButton="true" styleClass="secondary-button"/>
    </HBox>

</VBox>
