<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.clinicflow.Controllers.PatientListController"
      stylesheets="@styles.css"
      spacing="14">

    <padding>
        <Insets top="10" left="10" right="10" bottom="10"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Patients" styleClass="page-title"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by patient ID or name" styleClass="search-field" HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchButton" text="Search" onAction="#handleSearch"/>
        <Button fx:id="clearButton" text="Clear" onAction="#handleClearSearch" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
            <TableColumn fx:id="ageColumn" text="Age" prefWidth="60"/>
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130"/>
            <TableColumn fx:id="addressColumn" text="Address" prefWidth="220"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addButton" text="Add Patient" onAction="#handleAdd"/>
        <Button fx:id="editButton" text="Edit" onAction="#handleEdit" styleClass="secondary-button"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="refresh-button"/>
    </HBox>

</VBox>
