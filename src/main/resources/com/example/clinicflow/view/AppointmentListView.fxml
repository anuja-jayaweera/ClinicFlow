<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.clinicflow.Controllers.AppointmentListController"
      stylesheets="@styles.css"
      spacing="14">

    <padding>
        <Insets top="10" left="10" right="10" bottom="10"/>
    </padding>

    <Label text="Appointments" styleClass="page-title"/>

    <TableView fx:id="appointmentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="100"/>
            <TableColumn fx:id="doctorIdColumn" text="Doctor ID" prefWidth="100"/>
            <TableColumn fx:id="dateTimeColumn" text="Date &amp; Time" prefWidth="150"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="130"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="bookButton" text="Book Appointment" onAction="#handleBook"/>
        <Button fx:id="rescheduleButton" text="Reschedule" onAction="#handleReschedule" styleClass="secondary-button"/>
        <Button fx:id="completeButton" text="Mark Completed" onAction="#handleComplete" styleClass="secondary-button"/>
        <Button fx:id="cancelButton" text="Cancel Appointment" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="refresh-button"/>
    </HBox>

</VBox>
